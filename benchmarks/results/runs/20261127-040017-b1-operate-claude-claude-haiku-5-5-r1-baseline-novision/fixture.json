 "lines": [
  {
   "id": "n01",
   "who": "kai",
   "kind": "vo",
   "text": "In my town, everyone is born with a number of hugs."
  },
  {
   "id": "n02",
   "who": "kai",
   "kind": "vo",
   "text": "Most people get hundreds."
  },
  {
   "id": "n03",
   "who": "kai",
   "kind": "vo",
   "text": "I got zero."
  },
  {
   "id": "n04",
   "who": "kai",
   "kind": "vo",
   "text": "Zero means you can't give one. Not even to your mom."
  },
  {
   "id": "n05",
   "who": "kai",
   "kind": "vo",
   "text": "So every morning, she messes up my hair instead."
  },
  {
   "id": "n06",
   "who": "kai",
   "kind": "vo",
   "text": "Grandpa had one hug left."
  },
  {
   "id": "n07",
   "who": "kai",
   "kind": "vo",
   "text": "He'd been saving it for ten years."
  },
  {
   "id": "k01",
   "who": "kai",
   "voice": "kai_child",
   "kind": "dialogue",
   "text": "Who's it for, Grandpa?",
   "say": "Who is it for, Grandpa?"
  },
  {
   "id": "g01",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Not yet, kiddo."
  },
  {
   "id": "n08",
   "who": "kai",
   "kind": "vo",
   "text": "Everyone said he was just cold."
  },
  {
   "id": "n09",
   "who": "kai",
   "kind": "vo",
   "text": "Then, one winter night, Grandpa got sick."
  },
  {
   "id": "g02",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Come here, kiddo."
  },
  {
   "id": "n10",
   "who": "kai",
   "kind": "vo",
   "text": "That's when I learned the rule nobody tells you."
  },
  {
   "id": "n11",
   "who": "kai",
   "kind": "vo",
   "text": "You can't use your last hug."
  },
  {
   "id": "n12",
   "who": "kai",
   "kind": "vo",
   "text": "You can only give it away."
  },
  {
   "id": "g03",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "It was always yours."
  },
  {
   "id": "n13",
   "who": "kai",
   "kind": "vo",
   "text": "Grandpa saved his last hug for ten years."
  },
  {
   "id": "n14",
   "who": "kai",
   "kind": "vo",
   "text": "I only saved mine for ten seconds."
  }
 ],
