 "lines": [
  {"id": "n01", "who": "milo", "kind": "vo", "text": "In our town, your last lie floats above your head."},
  {"id": "n02", "who": "milo", "kind": "vo", "text": "Tell the truth, and it falls away."},
  {"id": "n03", "who": "milo", "kind": "vo", "text": "Mine had been there since spring."},
  {"id": "n04", "who": "milo", "kind": "vo", "text": "I told everyone, I'm fine."},
  {"id": "m01", "who": "mom", "kind": "dialogue", "text": "You don't have to be fine with me."},
  {"id": "n05", "who": "milo", "kind": "vo", "text": "But the lie was easier to carry than the truth."},
  {"id": "n06", "who": "milo", "kind": "vo", "text": "Grandpa was the only person who never looked up."},
  {"id": "n07", "who": "milo", "kind": "vo", "text": "He just asked me to sit beside him."},
  {"id": "g01", "who": "grandpa", "kind": "dialogue", "text": "Still carrying that one?"},
  {"id": "n08", "who": "milo", "kind": "vo", "text": "I thought he was pretending not to see it."},
  {"id": "n09", "who": "milo", "kind": "vo", "text": "Then his own lie appeared."},
  {"id": "n10", "who": "milo", "kind": "vo", "text": "I don't need help."},
  {"id": "g02", "who": "grandpa", "kind": "dialogue", "text": "Milo, come here."},
  {"id": "n11", "who": "milo", "kind": "vo", "text": "That was the first time I saw his hands shake."},
  {"id": "n12", "who": "milo", "kind": "vo", "text": "He wasn't hiding his lie from me."},
  {"id": "n13", "who": "milo", "kind": "vo", "text": "He was saving me from having to name mine."},
  {"id": "g03", "who": "grandpa", "kind": "dialogue", "text": "You can say it here."},
  {"id": "m02", "who": "milo", "kind": "dialogue", "text": "I miss Dad."},
  {"id": "n14", "who": "milo", "kind": "vo", "text": "The words fell. The room stayed."},
  {"id": "n15", "who": "milo", "kind": "vo", "text": "And Grandpa finally looked up."},
  {"id": "n16", "who": "milo", "kind": "vo", "text": "The truth was heavier than my lie."},
  {"id": "n17", "who": "milo", "kind": "vo", "text": "But I wasn't carrying it alone anymore."}
 ],
