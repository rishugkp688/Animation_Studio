   "emotion": 3
  },
  {
   "id": "reveal",
   "purpose": "Said to the one he lied to, the card falls; grandpa's card falls with his own truth.",
   "emotion": -3
  },
  {
   "id": "choice",
   "purpose": "Milo goes to the bed and holds on, with no lie left to hide behind.",
   "emotion": 5
  },
  {
   "id": "button",
   "purpose": "One line reframes the whole film.",
   "emotion": 4
  }
 ],
