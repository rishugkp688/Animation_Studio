 "lines": [
  {
   "id": "n01",
   "who": "hero",
   "kind": "vo",
   "text": "In my town, your last lie floats over your head."
  },
  {
   "id": "n02",
   "who": "hero",
   "kind": "vo",
   "text": "Mine has been up there since March."
  },
  {
   "id": "d01",
   "who": "other",
   "kind": "dialogue",
   "text": "Come on. I haven't got all day."
  },
  {
   "id": "n03",
   "who": "hero",
   "kind": "vo",
   "text": "In March he asked who broke it. I said, not me."
  },
  {
   "id": "n04",
   "who": "hero",
   "kind": "vo",
   "text": "He never asked again. He kept the radio on the shelf."
  },
  {
   "id": "n05",
   "who": "hero",
   "kind": "vo",
   "text": "The night he went into hospital, I ran."
  },
  {
   "id": "d02",
   "who": "hero",
   "kind": "dialogue",
   "text": "It was me."
  },
  {
   "id": "d03",
   "who": "other",
   "kind": "dialogue",
   "text": "Hey, kiddo. I'll be home Saturday."
  },
  {
   "id": "d04",
   "who": "hero",
   "kind": "dialogue",
   "text": "It was me. I broke the radio."
  },
  {
   "id": "d05",
   "who": "other",
   "kind": "dialogue",
   "text": "I know. I heard it hit the floor."
  },
  {
   "id": "d06",
   "who": "other",
   "kind": "dialogue",
   "text": "I won't be home Saturday."
  },
  {
   "id": "n06",
   "who": "hero",
   "kind": "vo",
   "text": "Nobody told me that. Only in front of the one you lied to."
  },
  {
   "id": "n07",
   "who": "hero",
   "kind": "vo",
   "text": "Mine floated for months. It came down in one sentence."
  }
 ],
 "beats": [
