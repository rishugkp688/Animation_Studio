  "lines": [
    {"id":"n01","who":"milo","kind":"vo","text":"In my town, your last lie floats above your head."},
    {"id":"n02","who":"milo","kind":"vo","text":"Truth makes it disappear."},
    {"id":"n03","who":"milo","kind":"vo","text":"Mine had been there four months."},
    {"id":"z01","who":"zoe","kind":"dialogue","text":"Your dad really flies planes?"},
    {"id":"n04","who":"milo","kind":"vo","text":"My dad cleaned our school every night."},
    {"id":"d01","who":"dad","kind":"dialogue","text":"Your pilot is running late."},
    {"id":"n05","who":"milo","kind":"vo","text":"At school, he pretended not to know me."},
    {"id":"n06","who":"milo","kind":"vo","text":"I thought he was ashamed of me too."},
    {"id":"n07","who":"milo","kind":"vo","text":"Then I found his night route."},
    {"id":"n08","who":"milo","kind":"vo","text":"School. Home. Mom's hospital. Every night."},
    {"id":"d02","who":"dad","kind":"dialogue","text":"She saved every drawing."},
    {"id":"n09","who":"milo","kind":"vo","text":"He wasn't hiding me. He was carrying us."},
    {"id":"d03","who":"dad","kind":"dialogue","text":"I'll wait by the side gate."},
    {"id":"k01","who":"milo","voice":"milo_child","kind":"dialogue","text":"No. He's my dad."},
    {"id":"z02","who":"zoe","kind":"dialogue","text":"The janitor?"},
    {"id":"k02","who":"milo","voice":"milo_child","kind":"dialogue","text":"The one who stayed."},
    {"id":"n10","who":"milo","kind":"vo","text":"My lie floated for four months."},
    {"id":"n11","who":"milo","kind":"vo","text":"The truth walked me home."}
  ],
  "beats": [
