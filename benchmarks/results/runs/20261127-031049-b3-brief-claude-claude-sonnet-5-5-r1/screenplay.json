 "lines": [
  {
   "id": "n01",
   "who": "jun",
   "kind": "vo",
   "text": "In my town, your last lie floats over your head."
  },
  {
   "id": "b01",
   "who": "bea",
   "kind": "dialogue",
   "text": "Fine. I didn't do it."
  },
  {
   "id": "n02",
   "who": "jun",
   "kind": "vo",
   "text": "Until you tell the truth."
  },
  {
   "id": "n03",
   "who": "jun",
   "kind": "vo",
   "text": "Mine's been up there since March."
  },
  {
   "id": "t01",
   "who": "theo",
   "kind": "dialogue",
   "text": "Is he flying today?"
  },
  {
   "id": "n05",
   "who": "jun",
   "kind": "vo",
   "text": "Nothing has ever floated over Dad's head."
  },
  {
   "id": "n06",
   "who": "jun",
   "kind": "vo",
   "text": "He reads mine every day. He never says a word."
  },
  {
   "id": "r01",
   "who": "nurse",
   "kind": "dialogue",
   "text": "Parents' day at his school tomorrow. You going?"
  },
  {
   "id": "d02",
   "who": "dad",
   "kind": "dialogue",
   "text": "Can't. I'm busy."
  },
  {
   "id": "n08",
   "who": "jun",
   "kind": "vo",
   "text": "My dad had never told a lie."
  },
  {
   "id": "t02",
   "who": "theo",
   "kind": "dialogue",
   "text": "Is that the pilot?"
  },
  {
   "id": "j01",
   "who": "jun",
   "kind": "dialogue",
   "text": "No. He cleans the hospital.",
   "voice": "jun_child"
  },
  {
   "id": "d03",
   "who": "dad",
   "kind": "dialogue",
   "text": "I wasn't busy.",
   "voice": "dad_quiet"
  },
  {
   "id": "n09",
   "who": "jun",
   "kind": "vo",
   "text": "My dad doesn't fly planes. He just kept my lie in the air."
  }
 ],
