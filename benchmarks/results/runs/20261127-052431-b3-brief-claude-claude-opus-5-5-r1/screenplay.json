 "lines": [
  {
   "id": "n01",
   "who": "ivy",
   "kind": "vo",
   "text": "In my town, your last lie floats over your head.",
   "say": "In my town... your last lie floats over your head."
  },
  {
   "id": "t01",
   "who": "theo",
   "kind": "dialogue",
   "text": "Fine. I didn't eat my lunch."
  },
  {
   "id": "n02",
   "who": "ivy",
   "kind": "vo",
   "text": "Until you tell the truth."
  },
  {
   "id": "n03",
   "who": "ivy",
   "kind": "vo",
   "text": "Mine has been up there for five months."
  },
  {
   "id": "n04",
   "who": "ivy",
   "kind": "vo",
   "text": "I said it the day Mom left me at Grandpa's."
  },
  {
   "id": "n05",
   "who": "ivy",
   "kind": "vo",
   "text": "Every day, he read it before he looked at me."
  },
  {
   "id": "n06",
   "who": "ivy",
   "kind": "vo",
   "text": "At night he cleans the hospital. I wait."
  },
  {
   "id": "n07",
   "who": "ivy",
   "kind": "vo",
   "text": "Grandpa never lied. Not even to be nice."
  },
  {
   "id": "g01",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Your aunt can take you. Back to the city."
  },
  {
   "id": "k01",
   "who": "ivy",
   "voice": "ivy_child",
   "kind": "dialogue",
   "text": "Do you want me to go?"
  },
  {
   "id": "g02",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Go. I'm fine alone."
  },
  {
   "id": "k02",
   "who": "ivy",
   "voice": "ivy_child",
   "kind": "dialogue",
   "text": "I lied. I hated it here."
  },
  {
   "id": "k03",
   "who": "ivy",
   "voice": "ivy_child",
   "kind": "dialogue",
   "text": "I like it here."
  },
  {
   "id": "n08",
   "who": "ivy",
   "kind": "vo",
   "text": "Grandpa told one lie in his whole life."
  },
  {
   "id": "n09",
   "who": "ivy",
   "kind": "vo",
   "text": "He never took it back."
  }
 ],
 "beats": [
  {
   "id": "hook",
   "purpose": "The rule on screen at once: I ATE MY LUNCH floats over Theo until he owns up and it pops.",
   "emotion": 2
  },
  {
   "id": "wound",
   "purpose": "I LIKE IT HERE has floated over Ivy for five months. Grandpa reads it, looks away and walks ahead of her.",
   "emotion": -3
  },
  {
   "id": "mystery",
   "purpose": "Night shift: Grandpa mops the corridor while Ivy waits on a plastic chair. Everyone's head carries a little lie; his is empty.",
   "emotion": -2
  },
  {
   "id": "turn",
   "purpose": "Grandpa has arranged for her aunt to take her back to the city: the thing her lie hid is what she wanted.",
   "emotion": -4
  },
  {
   "id": "reveal",
   "purpose": "He says Go, I'm fine alone, and the first lie of his life appears over his head: I'M FINE ALONE.",
   "emotion": -1
  },
  {
   "id": "choice",
   "purpose": "Ivy tells the truth that hurts him (I hated it here), her lie pops, then says the same words again and nothing floats.",
   "emotion": 4
  },
  {
   "id": "button",
   "purpose": "At the gate he waits for her and looks at her face, his lie still up; they walk out side by side.",
   "emotion": 3
  }
 ],
