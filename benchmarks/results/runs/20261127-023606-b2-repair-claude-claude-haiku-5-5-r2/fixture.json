 "lines": [
  {
   "id": "n01",
   "who": "leo",
   "kind": "vo",
   "text": "In my town, your head shows the last thing you said."
  },
  {
   "id": "n02",
   "who": "leo",
   "kind": "vo",
   "text": "Most of the time, it's something nice."
  },
  {
   "id": "n03",
   "who": "leo",
   "kind": "vo",
   "text": "Mine said I hate you.",
   "say": "Mine said... I hate you."
  },
  {
   "id": "n04",
   "who": "leo",
   "kind": "vo",
   "text": "I said it to my sister, three weeks ago."
  },
  {
   "id": "n05",
   "who": "leo",
   "kind": "vo",
   "text": "Then I stopped talking. So it stayed."
  },
  {
   "id": "a01",
   "who": "ava",
   "kind": "dialogue",
   "text": "Hurry up, Leo."
  },
  {
   "id": "n06",
   "who": "leo",
   "kind": "vo",
   "text": "Since Mom got sick, Ava did everything."
  },
  {
   "id": "a02",
   "who": "ava",
   "kind": "dialogue",
   "text": "Eat your dinner. I'll be back late."
  },
  {
   "id": "n07",
   "who": "leo",
   "kind": "vo",
   "text": "She never smiled. She never said anything nice."
  },
  {
   "id": "n08",
   "who": "leo",
   "kind": "vo",
   "text": "Every night she left. So one night, I followed her."
  },
  {
   "id": "n09",
   "who": "leo",
   "kind": "vo",
   "text": "She went to the hospital. To Mom."
  },
  {
   "id": "m01",
   "who": "mom",
   "kind": "dialogue",
   "text": "She comes every night. She only ever talks about you."
  },
  {
   "id": "n10",
   "who": "leo",
   "kind": "vo",
   "text": "The last thing she said was about me."
  },
  {
   "id": "k01",
   "who": "leo",
   "voice": "leo_child",
   "kind": "dialogue",
   "text": "I love you, Ava."
  },
  {
   "id": "a03",
   "who": "ava",
   "kind": "dialogue",
   "text": "Leo? You talked."
  },
  {
   "id": "n11",
   "who": "leo",
   "kind": "vo",
   "text": "For three weeks, my head said I hate you."
  },
  {
   "id": "n12",
   "who": "leo",
   "kind": "vo",
   "text": "It only took three words to fix it."
  }
 ],
 "beats": [
  {
   "id": "hook",
   "purpose": "The rule on screen at once: a boy's greeting and his dad's reply float above their heads.",
   "emotion": 1
  },
  {
   "id": "wound",
   "purpose": "Leo's head says I HATE YOU; he has not spoken since. Ava only ever says orders.",
   "emotion": -3
  },
  {
   "id": "mystery",
   "purpose": "Ava, cold and tired, leaves every night. Where does she go?",
   "emotion": -2
  },
  {
   "id": "turn",
   "purpose": "Leo follows her to the hospital: she visits Mom every night.",
   "emotion": 1
  },
  {
   "id": "reveal",
   "purpose": "Asleep in the chair, Ava's last words read HE MISSES YOU. She talks about Leo every night.",
   "emotion": -2
  },
  {
   "id": "choice",
   "purpose": "Leo speaks for the first time: I love you, Ava. His words change.",
   "emotion": 4
  },
  {
   "id": "button",
   "purpose": "Three weeks of the wrong words; three words to fix it.",
   "emotion": 3
  }
 ],
