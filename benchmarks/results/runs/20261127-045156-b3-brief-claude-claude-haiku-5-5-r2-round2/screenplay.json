 "lines": [
  {
   "id": "n01",
   "who": "milo",
   "kind": "vo",
   "text": "In this town, the last lie you tell floats over your head."
  },
  {
   "id": "n02",
   "who": "milo",
   "kind": "vo",
   "text": "Until you tell the truth."
  },
  {
   "id": "n03",
   "who": "milo",
   "kind": "vo",
   "text": "Mine has floated for months."
  },
  {
   "id": "d01",
   "who": "lily",
   "voice": "lily",
   "kind": "dialogue",
   "text": "Where's your dad, Milo?"
  },
  {
   "id": "d02",
   "who": "milo",
   "voice": "milo_child",
   "kind": "dialogue",
   "text": "He's away on a job."
  },
  {
   "id": "n04",
   "who": "milo",
   "kind": "vo",
   "text": "Everyone believed me."
  },
  {
   "id": "n05",
   "who": "milo",
   "kind": "vo",
   "text": "Grandpa's tag says FINE. Mine says AWAY.",
   "say": "Grandpa's tag says fine. Mine says away."
  },
  {
   "id": "d03",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Did you see him today?"
  },
  {
   "id": "d04",
   "who": "milo",
   "voice": "milo_child",
   "kind": "dialogue",
   "text": "He's away, Grandpa."
  },
  {
   "id": "d05",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Go do your homework.",
   "say": "Go. Do your homework."
  },
  {
   "id": "d06",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Get your shoes. Now."
  },
  {
   "id": "d07",
   "who": "mom",
   "kind": "dialogue",
   "text": "He's been asking for you, Milo."
  },
  {
   "id": "n07",
   "who": "milo",
   "kind": "vo",
   "text": "Dad fell off a roof in March. I said he was away."
  },
  {
   "id": "d08",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "I'm not fine, kiddo."
  },
  {
   "id": "d09",
   "who": "dad",
   "kind": "dialogue",
   "text": "You came, buddy."
  },
  {
   "id": "d10",
   "who": "milo",
   "voice": "milo_child",
   "kind": "dialogue",
   "text": "You're not away. You're here."
  },
  {
   "id": "d11",
   "who": "dad",
   "kind": "dialogue",
   "text": "I was scared too.",
   "say": "I was scared, too."
  },
  {
   "id": "d12",
   "who": "milo",
   "voice": "milo_child",
   "kind": "dialogue",
   "text": "My dad's in the hospital."
  },
  {
   "id": "d13",
   "who": "lily",
   "voice": "lily",
   "kind": "dialogue",
   "text": "I didn't do my homework."
  },
  {
   "id": "n09",
   "who": "milo",
   "kind": "vo",
   "text": "It floated for months. The truth took one sentence."
  }
 ],
 "beats": [
  {
   "id": "hook",
   "purpose": "Show the rule in 2 s: a word floats over Milo's head and Lily's and Nina's.",
   "emotion": 1
  },
  {
   "id": "wound",
   "purpose": "Milo tells the lie out loud to a friend; everyone believes it and the tag still floats.",
   "emotion": -2
  },
  {
   "id": "mystery",
   "purpose": "Grandpa seems cold and says FINE on his own tag. Milo cannot get a straight answer.",
   "emotion": -1
  },
  {
   "id": "turn",
   "purpose": "Mom says Dad has been asking; Grandpa admits he is not fine and his tag clears.",
   "emotion": 3
  },
  {
   "id": "reveal",
   "purpose": "Dad is in the bed. Milo tells him the truth and his own tag falls.",
   "emotion": -3
  },
  {
   "id": "choice",
   "purpose": "Milo lets the fear out in front of Dad instead of hiding behind the tag.",
   "emotion": 4
  },
  {
   "id": "button",
   "purpose": "At the gate Milo says the truth to Lily in one sentence; the tag is gone.",
   "emotion": 4
  }
 ],
