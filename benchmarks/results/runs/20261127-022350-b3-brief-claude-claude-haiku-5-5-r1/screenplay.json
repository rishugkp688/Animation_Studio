 "lines": [
  {
   "id": "n01",
   "who": "kit",
   "kind": "vo",
   "text": "In this town, your last lie floats above your head."
  },
  {
   "id": "n02",
   "who": "kit",
   "kind": "vo",
   "text": "Until you tell the truth."
  },
  {
   "id": "d_ruby",
   "who": "ruby",
   "kind": "dialogue",
   "text": "I broke your bike, Dad."
  },
  {
   "id": "n03",
   "who": "kit",
   "kind": "vo",
   "text": "Mine has floated since March."
  },
  {
   "id": "n04",
   "who": "kit",
   "kind": "vo",
   "text": "Grandpa believed me."
  },
  {
   "id": "n05",
   "who": "kit",
   "kind": "vo",
   "text": "Everybody can read it. Nobody says a word."
  },
  {
   "id": "n06",
   "who": "kit",
   "kind": "vo",
   "text": "Grandpa has floated I'M FINE for four years."
  },
  {
   "id": "g01",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Did you touch her picture?"
  },
  {
   "id": "n07",
   "who": "kit",
   "kind": "vo",
   "text": "He keeps looking at her picture, not at me."
  },
  {
   "id": "n08",
   "who": "kit",
   "kind": "vo",
   "text": "He'd been alone all night."
  },
  {
   "id": "d_mom",
   "who": "mom",
   "kind": "dialogue",
   "text": "He fell. He keeps asking for you."
  },
  {
   "id": "g03",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "I've been reading yours since March."
  },
  {
   "id": "g04",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "Nobody can say it for you."
  },
  {
   "id": "k02",
   "who": "kit",
   "kind": "dialogue",
   "text": "It was me. I broke her picture."
  },
  {
   "id": "k03",
   "who": "kit",
   "kind": "dialogue",
   "text": "I said it wasn't me."
  },
  {
   "id": "g05",
   "who": "grandpa",
   "kind": "dialogue",
   "text": "I'm not fine, either."
  },
  {
   "id": "n09",
   "who": "kit",
   "kind": "vo",
   "text": "Mine floated for four months."
  },
  {
   "id": "n10",
   "who": "kit",
   "kind": "vo",
   "text": "His floated for four years."
  }
 ],
 "beats": [
  {
   "id": "hook",
   "purpose": "The rule is visible at the gate in two seconds: Ruby's lie clears when she tells her dad; Kit's stays.",
   "emotion": 1
  },
  {
   "id": "wound",
   "purpose": "Kit's lie to Grandpa about the photo, and the town's silence about it.",
   "emotion": -2
  },
  {
   "id": "mystery",
   "purpose": "Grandpa's own I'M FINE floats over his armchair, and he will not look at Kit.",
   "emotion": -1
  },
  {
   "id": "turn",
   "purpose": "Grandpa falls. Mom says he keeps asking for Kit. Kit walks to Room 12.",
   "emotion": 3
  },
  {
   "id": "reveal",
   "purpose": "Grandpa has been reading Kit's lie since March, and nobody can say it for Kit.",
   "emotion": -3
  },
  {
   "id": "choice",
   "purpose": "Kit says the truth out loud at the cost of crying in front of him; both lies clear.",
   "emotion": 5
  },
  {
   "id": "button",
   "purpose": "Back at the gate: Kit's badge is gone and his mother ruffles his hair again. His grandfather's lie lasted longer.",
   "emotion": 4
  }
 ],
